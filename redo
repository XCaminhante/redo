#!/bin/bash
# An implementation of djb's redo, written in bash shell
# See cr.yp.to/redo.html for more about redo
# This work is placed in the Public Domain

function onTerm { wait; exit 111; }
trap onTerm SIGINT SIGTERM
PARALLELJOBS=${PARALLELJOBS:=2}
PROGNAME="$(basename "$0")"

#NODE Utilities
#NODE * Msg
function Msg {
  local level="$1: "
  shift
  case "$level" in
    info\:\ ) level= ;;
  esac
  echo "${level}${*}" >&2
  case "$level" in
    error\:\ ) echo "${level}${*}" >"$ERROR_FIFO" ;;
    abort\:\ ) echo "${level}${*}" >"$ERROR_FIFO"; exit 111 ;;
  esac
}
#NODE * Basename
# /home/user/t.a.b.c => t
function Basename {
  local bn="${1%%.*}"
  echo "${bn##*/}"
}
#NODE * BasenamePath
# /home/user/t.a.b.c => /home/user/t
function BasenamePath {
  echo "${1%%\.*}"
}
#NODE * Extension
# /home/user/t.a.b.c => a.b.c
function Extension {
  echo "${1#*.}"
}
#NODE * Checksum
function Checksum {
  [ ! -s "$1" ] && { echo '00000000000000000000000000000000'; return; }
  md5sum "$1" | grep -oE '^.{32}'
}
#NODE * SortFile
function SortFile {
  local tmp="$(mktemp -t "XXXXXX.tmp")"
  cat "$1" | sort -g -k1 > "$tmp"
  mv -f "$tmp" "$1"
}
#NODE Dependencies' database
#NODE * TargetChangesFile
# MD5 hashes of dependency files
function TargetChangesFile {
  echo "${METADIR}/${1}/md5.sum"
}
#NODE * TargetCreatesFile
# Paths of files that must not exist at (re)build time (some dofile will create them)
function TargetCreatesFile {
  echo "${METADIR}/${1}/exists.txt"
}
#NODE * TargetComputedChangesFile
# MD5 hashes of computed dependencies (dependencies on executables' outputs)
function TargetComputedChangesFile {
  echo "${METADIR}/${1}/compmd5.sum"
}
#NODE * AddIfChange
function AddIfChange {
  LockMetadata "$2" ifchange
  local tmp="$(mktemp -t "XXXXXX.tmp")"
  sed -r "\%^.{32}  ${1}$% d" "$(TargetChangesFile "$2")" > "$tmp"
  md5sum "$1" >> "$tmp"
  mv -f "$tmp" "$(TargetChangesFile "$2")"
  ReleaseLock "$2" ifchange
}
#NODE * AddIfCreate
function AddIfCreate {
  LockMetadata "$2" ifcreate
  local tmp="$(mktemp -t "XXXXXX.tmp")"
  sed -r "\%^${1}$% d" "$(targetCreatesFile "$2")" > "$tmp"
  echo "$1" >> "$tmp"
  mv -f "$tmp" "$(targetCreatesFile "$2")"
  ReleaseLock "$2" ifcreate
}
#NODE * AddIfComputedChange
function AddIfComputedChange {
  LockMetadata "$2" ifcomputedchange
  local tmp="$(mktemp -t "XXXXXX.tmp")"
  sed -r "\%^.{32} \*${1}$% d" "$(TargetComputedChangesFile "$2")" > "$tmp"
  cd "$(dirname "$1")"
  "$1" | md5sum -b - | sed -r "s%-$%${1}%" >> "$tmp"
  mv -f "$tmp" "$(TargetComputedChangesFile "$2")"
  ReleaseLock "$2" ifcomputedchange
}
#NODE * DependencySum
function DependencySum {
  sed -r "\%  ${1}$% !d; s%(^.{32})  ${1}%\1%" "$(TargetChangesFile "$2")"
}
#NODE * ComputedSum
function ComputedSum {
  sed -r "\% \*${1}$% !d; s%(^.{32}) \*${1}%\1%" "$(TargetComputedChangesFile "$2")"
}
#NODE * ClearMetadata
function ClearMetadata {
  InitializeMetadata "$1"
  echo -n > "$(TargetChangesFile "$1")"
  echo -n > "$(TargetCreatesFile "$1")"
  echo -n > "$(TargetComputedChangesFile "$1")"
}
#NODE * InitializeMetadata
function InitializeMetadata {
  mkdir -p "${METADIR}/${1}"
  touch "$(TargetChangesFile "$1")" "$(TargetCreatesFile "$1")" "$(TargetComputedChangesFile "$1")"
}
#NODE * LockMetadata
function LockMetadata {
  local lock="${METADIR}/${1}/${2}"
  while ! mkdir "$lock" 2>/dev/null; do sleep 0.001; done
}
#NODE * ReleaseLock
function ReleaseLock {
  local lock="${METADIR}/${1}/${2}"
  rmdir "$lock" 2>/dev/null
}
#NODE * TargetDependencies
function TargetDependencies {
  [ -s "$(TargetChangesFile "$1")" ] && sed -r 's/^.{32}  //' "$(TargetChangesFile "$1")"
}
#NODE * TargetComputedDependencies
function TargetComputedDependencies {
  [ -s "$(TargetComputedChangesFile "$1")" ] && sed -r 's/^.{32} \*//' "$(TargetComputedChangesFile "$1")"
}
#NODE Target/dependencies operations
#NODE * TargetCantCreate
function TargetCantCreate {
  ! xargs -a "$(TargetCreatesFile "$1")" -r -I% \[ ! -e "%" \]
}
#NODE * DoPath
function DoPath {
  if [ -e "${1}.do" ]; then
    echo "${1}.do"
  elif [ -e "$(dirname "$1")/default.$(Extension "$1").do" ]; then
    echo "$(dirname "$1")/default.$(Extension "$1").do"
  elif [ -e "${BUILDDIR}/default.$(Extension "$1").do" ]; then
    echo "${BUILDDIR}/default.$(Extension "$1").do"
  else
    echo ""
  fi
}
#NODE * BuildTarget
function BuildTarget {
  local target="$1"
  local doPath="$2"
  [ -z "$doPath" ] && doPath="$(DoPath "$target")"
  local tmp="${target}--redoing"
  local RC=111
  ClearMetadata "$target"
  AddIfChange "$doPath" "$target"
  mkdir -p "$(dirname "$target")"
  cd "$(dirname "$target")"
  Msg "info" "Building target '$target'"
  #Msg debug "BuildTarget: REDO_TARGET='$target' *$([ -x "$doPath" ] || echo 'sh ')'$doPath'* '$(Basename "$target")' '$(BasenamePath "$target")' '$tmp'"
  REDO_TARGET="$target" $([ -x "$doPath" ] || echo sh) "$doPath" \
    "$(Basename "$target")" "$(BasenamePath "$target")" "$tmp" > "$tmp"
  RC=$?
  if [ $RC -ne 0 ]; then
    Msg "error" "Dofile '$doPath', while building '$target', exited with a non-zero exit code: $RC"
    rm -f "$tmp" "$target"
    exit $RC
  elif [ -s "$tmp" ]; then
    mv -f "$tmp" "$target"
    true
  else
    rm -f "$tmp" "$target"
    false
  fi
}
#NODE * Redo
function Redo {
  local file="$1"
  local doPath="$(DoPath "$file")"
  if [ ! -z "$doPath" ]; then
    local dep
    InitializeMetadata "$file"
    #NODE ** a) verify files that must be created by a dofile
    if TargetCantCreate "$file"; then
      Msg "error" "While rebuilding '$file', the following files should be created by a dofile but already exist:"
      xargs -a "$(TargetCreatesFile "$file")" -r -I% find "%" 2>/dev/null
      exit 111
    fi
    LockMetadata "$file" target
    if [ ! -s "$file" ]; then
      BuildTarget "$file" "$doPath" && AddIfChange "$file" "$file"
    else
      #NODE ** b) rebuild dependencies if necessary
      SortFile "$(TargetChangesFile "$file")"
      oldsum=$(Checksum "$(TargetChangesFile "$file")")
      TargetDependencies "$file" | ( while read dep; do
        [ "$dep" != "$file" ] && { REDO_TARGET="$file" Redo "$dep"; }&
        # This only limits the number of processes per sub-target
        # A true implementation need to implement the jobserver protocol
        while [ $(jobs -p | wc -l) -ge $PARALLELJOBS ]; do wait -n; done
      done; wait; )
      SortFile "$(TargetChangesFile "$file")"
      newsum=$(Checksum "$(TargetChangesFile "$file")")
      #NODE ** c) verify computed dependencies
      SortFile "$(TargetComputedChangesFile "$file")"
      oldcsum=$(Checksum "$(TargetComputedChangesFile "$file")")
      TargetComputedDependencies "$file" | while read dep; do
        AddIfComputedChange "$dep" "$file";
      done
      SortFile "$(TargetComputedChangesFile "$file")"
      newcsum=$(Checksum "$(TargetComputedChangesFile "$file")")
      #NODE ** d) rebuild the target if its dependencies changed
      oldtsum=$(DependencySum "$file" "$file")
      newtsum=$(Checksum "$file")
      [ "$oldsum" != "$newsum" ] && Msg info "Target '$file' dependencies changed ($oldsum -> $newsum)"
      [ "$oldcsum" != "$newcsum" ] && Msg info "Target '$file' computed dependencies changed ($oldcsum -> $newcsum)"
      [ "$oldtsum" != "$newtsum" ] && Msg info "Target '$file' checksum changed ($oldtsum -> $newtsum)"
      if [ "$oldsum" != "$newsum" ] || [ "$oldcsum" != "$newcsum" ] || [ "$oldtsum" != "$newtsum" ]; then
        BuildTarget "$file" "$doPath" && AddIfChange "$file" "$file";
      fi
    fi
    ReleaseLock "$file" target
  else
    #NODE ** e) when the file is not a target:
    [ -e "$file" ] || Msg "abort" "While redoing target '$REDO_TARGET', no dofile found for '$file'"
  fi
  [ -s "$file" ] && AddIfChange "$file" "$REDO_TARGET";
}
#NODE Main code
case "$PROGNAME" in
redo-ifcomputedchange)
  [ -z "$ERROR_FIFO" ] && exit 111
  [ -z "$REDO_TARGET" ] && Msg "abort" "redo-ifcomputedchange ${*}: REDO_TARGET not set"
  [ -z "$BUILDDIR" ] && Msg "abort" "redo-ifcomputedchange ${*}: BUILDDIR not set"
  [ -z "$METADIR" ] && Msg "abort" "redo-ifcomputedchange ${*}: METADIR not set"
  for dep; do
    dep="$(readlink -m "$dep")"
    DEPDIR="$(dirname "$dep")"
    { mkdir -p "$DEPDIR"; cd "$DEPDIR" && Redo "$dep" && AddIfComputedChange "$dep" "$REDO_TARGET"; }&
    while [ $(jobs -p | wc -l) -ge $PARALLELJOBS ]; do wait -n; done
  done; wait
;;
redo-ifchange)
  [ -z "$ERROR_FIFO" ] && exit 111
  [ -z "$REDO_TARGET" ] && Msg "abort" "redo-ifchange ${*}: REDO_TARGET not set"
  [ -z "$BUILDDIR" ] && Msg "abort" "redo-ifchange ${*}: BUILDDIR not set"
  [ -z "$METADIR" ] && Msg "abort" "redo-ifchange ${*}: METADIR not set"
  for dep; do
    dep="$(readlink -m "$dep")"
    DEPDIR="$(dirname "$dep")"
    { mkdir -p "$DEPDIR"; cd "$DEPDIR" && Redo "$dep"; }&
    while [ $(jobs -p | wc -l) -ge $PARALLELJOBS ]; do wait -n; done
  done; wait
;;
redo-ifcreate)
  [ -z "$ERROR_FIFO" ] && exit 111
  [ -z "$REDO_TARGET" ] && Msg "abort" "redo-ifcreate ${*}: REDO_TARGET not set"
  [ -z "$BUILDDIR" ] && Msg "abort" "redo-ifcreate ${*}: BUILDDIR not set"
  [ -z "$METADIR" ] && Msg "abort" "redo-ifcreate ${*}: METADIR not set"
  for dep; do
    dep="$(readlink -m "$dep")"
    [ -e "$dep" ] && Msg "abort" "For target '$REDO_TARGET', '$dep' exists but should be created by a dofile"
    DEPDIR="$(dirname "$dep")"
    { mkdir -p "$DEPDIR"; cd "$DEPDIR" && Redo "$dep" && AddIfCreate "$dep" "$REDO_TARGET"; }&
    while [ $(jobs -p | wc -l) -ge $PARALLELJOBS ]; do wait -n; done
  done; wait
;;
redo|redo.sh)
  ERROR_FIFO="$(mktemp -u -t "XXXXXX.tmp")"
  mkfifo "$ERROR_FIFO"; exec 3<>"$ERROR_FIFO"; rm "$ERROR_FIFO"
  ERROR_FIFO=/proc/self/fd/3
  for arg; do
    arg="$(readlink -m "$arg")"
    REDO_TARGET="$arg"
    BUILDDIR="$(dirname "$arg")"
    METADIR="${BUILDDIR}/.redo"
    ( export REDO_TARGET BUILDDIR METADIR ERROR_FIFO; cd "$BUILDDIR"; Redo "$arg" )&
    while [ $(jobs -p | wc -l) -ge $PARALLELJOBS ]; do wait -n; done
  done; wait
  read -u3 -t0 && {
    Msg alert "Build failed, failure reasons:"
    while read -u3  msg; do
      Msg info "* ${msg}"
    done; exit 1; }
  exec 3>&-
;;
esac
exit 0
